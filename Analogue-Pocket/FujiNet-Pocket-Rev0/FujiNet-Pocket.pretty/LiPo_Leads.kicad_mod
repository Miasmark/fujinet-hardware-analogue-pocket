(footprint "LiPo_Leads"
	(version 20241229)
	(generator "fujinet_gen")
	(layer "F.Cu")
	(descr "Hand-solder pads for a 1S LiPo's leads: 1 (+) at +x, 2 (-) at -x; the cell rides on a shelf in the shell over the components (gen_pcb.CELL); no part placed")
	(tags "lipo battery leads solder pads")
	(property "Reference" "REF**" (at 0 -2.4 0) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.12))))
	(property "Value" "LiPo" (at 0 2.4 0) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
	(attr smd exclude_from_pos_files exclude_from_bom)
	(pad "1" smd rect (at 3 0) (size 3 2.4) (layers "F.Cu" "F.Mask"))
	(fp_text user "+" (at 5.5 0 0) (layer "F.SilkS") (effects (font (size 1.5 1.5) (thickness 0.225))))
	(pad "2" smd rect (at -3 0) (size 3 2.4) (layers "F.Cu" "F.Mask"))
	(fp_text user "-" (at -5.5 0 0) (layer "F.SilkS") (effects (font (size 1.5 1.5) (thickness 0.225))))
	(fp_rect (start -6.5 -1.5) (end 6.5 1.5) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
)
